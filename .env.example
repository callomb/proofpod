# ProofPod environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard: Project Settings -> API

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. NEVER expose this to the browser or commit it.
# Used for generating signed URLs for evidence photos and (optionally) admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public URL the app is served from (used for invite links / auth redirects).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. NEVER expose this to the browser or commit it.
# Used by the AC Commissioning module to suggest model/serial numbers from a
# data-plate photo (a suggestion only — the engineer always confirms it).
# Get a key from https://console.anthropic.com/ — without it, data-plate
# photos still capture and save fine, the engineer just enters model/serial
# manually. https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server only. NEVER expose this to the browser or commit it.
# Lets the Supabase CLI (`npx supabase ...`) apply supabase/migrations/ to
# this project directly, instead of pasting each one into the SQL Editor.
# Generate a "Project" scoped token with Database access at
# https://supabase.com/dashboard/account/tokens — see SETUP.md.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Server only. NEVER expose these to the browser or commit them.
# "Request F-Gas label" sends a completed system's label details to Tagref.
# TAGREF_FGAS_URL is the address Tagref gives you for receiving requests and
# TAGREF_FGAS_KEY is the shared secret that must match the one set on Tagref.
# Without them the button still saves the request and offers a Retry once
# they're configured.
TAGREF_FGAS_URL=https://www.tagref.co.uk/api/proofpod/fgas-label-requests
TAGREF_FGAS_KEY=your-shared-secret
